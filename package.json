{
  "name": "lovely-assertions.dev",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "docs:fetch": "node scripts/fetch-docs.ts",
    "docs:render": "node pipeline/build.ts",
    "wheel:fetch": "node scripts/fetch-wheel.ts",
    "fonts:fetch": "node scripts/fetch-fonts.ts",
    "og:make": "node scripts/make-og-image.ts",
    "content": "pnpm run docs:fetch && pnpm run docs:render && pnpm run wheel:fetch",
    "dev": "pnpm run content && react-router dev",
    "build": "react-router build",
    "search:index": "node scripts/search-index.ts",
    "gate:parity": "node scripts/gate-parity.ts",
    "gate:layout": "node scripts/check-layout.ts",
    "gate:motion": "node scripts/check-motion.ts",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test 'tests/**/*.test.ts'",
    "ci:before": "pnpm run content && pnpm run lint && pnpm run typecheck && pnpm test && pnpm run gate:parity",
    "ci:after": "pnpm run search:index && pnpm run sitemap && pnpm run agents && pnpm run gate:built && pnpm run gate:runnable && pnpm run gate:agents && pnpm run gate:a11y && pnpm run gate:layout && pnpm run gate:motion",
    "ci": "pnpm run ci:before && pnpm run build && pnpm run ci:after",
    "icons:make": "node scripts/make-icons.ts",
    "sitemap": "node scripts/sitemap.ts",
    "agents": "node scripts/agents.ts",
    "gate:runnable": "node scripts/check-runnable.ts",
    "gate:agents": "node scripts/check-agents.ts",
    "gate:a11y": "node scripts/check-a11y.ts",
    "gate:built": "node --test tests/built-pages.after-build.ts"
  },
  "dependencies": {
    "@react-router/node": "8.3.1",
    "@shikijs/rehype": "4.4.3",
    "github-slugger": "2.0.0",
    "gsap": "3.15.0",
    "isbot": "^5",
    "mdast-util-to-hast": "13.2.1",
    "mdast-util-to-string": "4.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.1",
    "rehype-autolink-headings": "7.1.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "remark-stringify": "11.0.0",
    "shiki": "4.4.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vfile": "6.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@react-router/dev": "8.3.1",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/tar-stream": "3.1.4",
    "@types/unist": "3.0.3",
    "pagefind": "1.5.2",
    "puppeteer": "25.9.0",
    "pyodide": "314.0.6",
    "tar-stream": "3.2.1",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
